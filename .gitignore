# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs ingestion — raw cloned/fetched docs are not committed;
# data/embeddings/ (the generated index) MAY be committed, see blueprint §11
/data/raw-docs/*
!/data/raw-docs/.gitkeep

# stray screenshots from ad-hoc local verification scripts (page.screenshot()
# with a relative path lands here) — real image assets live under public/ or
# app/, never at the repo root, so this is safe to blanket-ignore.
/*.png
/*.jpg
/*.jpeg
