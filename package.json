{
  "name": "playwright-ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest:fetch": "tsx scripts/fetch-docs.ts",
    "ingest:parse": "tsx scripts/parse-docs.ts",
    "ingest:chunk": "tsx scripts/chunk-docs.ts",
    "ingest": "tsx scripts/embed-docs.ts",
    "eval:correctness_playwright_qa": "dotenv -e .env -- promptfoo eval -c prompt-evals/tests/correctness/correctness_playwright_qa_promptfooconfig.yaml",
    "eval:refusal_offtopic_adversarial": "dotenv -e .env -- promptfoo eval -c prompt-evals/tests/refusal/refusal_offtopic_adversarial_promptfooconfig.yaml",
    "eval:benchmark_provider_comparison": "dotenv -e .env -- promptfoo eval -c prompt-evals/tests/benchmark/benchmark_gemini_vs_openai_vs_anthropic_promptfooconfig.yaml --no-cache",
    "eval:all": "npm run eval:correctness_playwright_qa && npm run eval:refusal_offtopic_adversarial && npm run eval:benchmark_provider_comparison",
    "eval:view": "promptfoo view",
    "redteam:jailbreak_basic": "dotenv -e .env -- promptfoo redteam run -c prompt-evals/red-teaming/jailbreakBasic/promptfooconfig.yaml --delay 5000",
    "notify:slack": "tsx prompt-evals/scripts/notify-slack.ts",
    "write:summary": "tsx prompt-evals/scripts/write-summary.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.15",
    "@ai-sdk/google": "^4.0.17",
    "@ai-sdk/openai": "^4.0.15",
    "@ai-sdk/react": "^4.0.31",
    "@base-ui/react": "^1.6.0",
    "@vercel/speed-insights": "^2.0.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^7.0.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "promptfoo": "^0.123.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
